{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.wnsod/oneqaz-trading-mcp",
  "title": "Trading Signal & Market Regime MCP Server",
  "description": "Trading MCP with regime detection + self-verifying Trust Layer. Crypto, US, KR stocks. 24/7 live.",
  "version": "0.4.3",
  "repository": {
    "url": "https://github.com/oneqaz-trading/oneqaz-trading-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "oneqaz-trading-mcp",
      "version": "0.4.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PG_HOST",
          "description": "PostgreSQL host (OneQAZ-compatible schema; read-only role suffices)",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "PG_PASSWORD",
          "description": "PostgreSQL password",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "PG_USER",
          "description": "PostgreSQL user (default: auto_trader)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "PG_DB",
          "description": "PostgreSQL database (default: auto_trader)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "MCP_SERVER_PORT",
          "description": "Server port (default: 8010)",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
