{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.wnsod/oneqaz-trading-mcp",
  "title": "OneQAZ Trading Intelligence",
  "description": "Verifiable crypto/KR/US market intelligence for AI agents: signals, hash-chained ledger. Not advice.",
  "version": "1.2.0",
  "websiteUrl": "https://oneqaz.com",
  "repository": {
    "url": "https://github.com/oneqaz-trading/oneqaz-trading-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "oneqaz-trading-mcp",
      "version": "0.4.4",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PG_HOST",
          "description": "PostgreSQL host (OneQAZ-compatible schema; read-only role suffices)",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "PG_PASSWORD",
          "description": "PostgreSQL password",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "PG_USER",
          "description": "PostgreSQL user (default: auto_trader)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "PG_DB",
          "description": "PostgreSQL database (default: auto_trader)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "MCP_SERVER_PORT",
          "description": "Server port (default: 8010)",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.oneqaz.com/mcp",
      "headers": [
        {
          "name": "X-API-Key",
          "description": "API key for higher rate limits (optional — free tier: 1,500 req/day without key)",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
