# =============================================================================
# oneqaz-trading-mcp Configuration (0.4.0+ — PostgreSQL-only)
# =============================================================================

# Server
MCP_SERVER_PORT=8010
MCP_SERVER_HOST=0.0.0.0
MCP_LOG_LEVEL=INFO

# Database (required for self-hosting — a read-only role is enough)
DB_BACKEND=postgres
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=auto_trader
PG_USER=mcp_ro
PG_PASSWORD=change_me
# PG_POOL_MIN=0
# PG_POOL_MAX=50
# PG_STATEMENT_TIMEOUT_MS=30000

# Tier resolution for self-hosters (optional):
# a "module:function" import path; the function receives an API key string
# and returns "free" / "pro" / "internal".
# MCP_TIER_RESOLVER=my_module:resolve_tier

# Logical data-path roots (optional — these are PG routing keys, not real
# directories; only override if your deployment relocates them)
# MCP_COIN_DATA_DIR=/path/to/coin/data_storage
# MCP_KR_DATA_DIR=/path/to/kr/data_storage
# MCP_US_DATA_DIR=/path/to/us/data_storage
# MCP_EXTERNAL_CONTEXT_DATA_DIR=/path/to/external_context/data_storage
